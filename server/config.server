# Adaptador principal del servidor (escucha en todas las interfaces de red)
ChatAdapter.Endpoints=tcp -h * -p 10000

# Tamano maximo de mensaje Ice en KB (defecto 1024). Los chunks de archivos deben ser menores.
Ice.MessageSizeMax=2048

# Pool de hilos del servidor (el despacho es concurrente -> estado thread-safe)
Ice.ThreadPool.Server.Size=4
Ice.ThreadPool.Server.SizeMax=16

#Misma conexión activa del config.client
# Cierra automáticamente las conexiones que llevan 30 segundos inactivas.
Ice.ACM.Server.Timeout=30 #Garantiza que si no se envían bytes despues de 30 segundos por el socket
# 3 significa "Always": El servidor enviará pequeños "latidos" (heartbeats) 
# por la red para asegurarse de que el cliente sigue vivo y evitar que la 
# conexión se cierre por inactividad.
Ice.ACM.Server.Heartbeat=3 #Manda info muy pequeña para mantener el socket abierto por un tiempo y que no se cierre tan rapido
Ice.Warn.Connections=1
